<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>PlatformSwitcher.CI</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR</DefineConstants>
    <PackageSourceDir Condition="'$(PackageSourceDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'Packages', 'io.github.hoppou-legion-gateway.platformswitcher'))</PackageSourceDir>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);MSB3277;NU1701;CS0618;CS0649;CS0414;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(PackageSourceDir)Runtime/**/*.cs" />
    <Compile Include="$(PackageSourceDir)Editor/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Unity3D.SDK" Version="2021.1.14.1" />
    <PackageReference Include="Unity3D.UnityEngine.UI" Version="2018.3.5.1" />
    <PackageReference Include="Unity3D.UnityEngine" Version="2018.3.5.1" ExcludeAssets="all" />
  </ItemGroup>

  <Target Name="EnsurePackageInstalled" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PackageSourceDir)package.json')"
           Text="package.json not found in $(PackageSourceDir)." />
  </Target>
</Project>
